  "questions": [
    {
      "id": "q1",
      "type": "single-choice",
      "question": "What is 5!?",
      "hint": "Multiply 5 × 4 × 3 × 2 × 1.",
      "options": [
        {
          "id": "A",
          "text": "25",
          "feedback": "That is 5 squared."
        },
        {
          "id": "B",
          "text": "60",
          "feedback": "You stopped early."
        },
        {
          "id": "C",
          "text": "120",
          "feedback": "Correct."
        },
        {
          "id": "D",
          "text": "240",
          "feedback": "That is double."
        }
      ],
      "correctOption": "C",
      "explanation": "5! = 120."
    },
    {
      "id": "q2",
      "type": "single-choice",
      "question": "Which is larger?",
      "hint": "Evaluate both values.",
      "options": [
        {
          "id": "A",
          "text": "3!",
          "feedback": "3! = 6."
        },
        {
          "id": "B",
          "text": "4!",
          "feedback": "Correct. 4! = 24."
        },
        {
          "id": "C",
          "text": "They are equal",
          "feedback": "6 and 24 are not equal."
        },
        {
          "id": "D",
          "text": "Cannot tell",
          "feedback": "Both can be evaluated."
        }
      ],
      "correctOption": "B",
      "explanation": "4! = 24 is larger than 3! = 6."
    },
    {
      "id": "q3",
      "type": "single-choice",
      "question": "What is 4! ÷ 3!?",
      "hint": "Write 4! = 4 × 3!.",
      "options": [
        {
          "id": "A",
          "text": "1",
          "feedback": "Not enough."
        },
        {
          "id": "B",
          "text": "3",
          "feedback": "Check cancellation."
        },
        {
          "id": "C",
          "text": "4",
          "feedback": "Correct."
        },
        {
          "id": "D",
          "text": "24",
          "feedback": "You did not divide."
        }
      ],
      "correctOption": "C",
      "explanation": "4! / 3! = (4 × 3!) / 3! = 4."
    }
  ]
