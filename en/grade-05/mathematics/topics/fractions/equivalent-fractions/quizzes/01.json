  "questions": [
    {
      "id": "q1",
      "type": "single-choice",
      "question": "Which fraction is equivalent to 1/2?",
      "hint": "Multiply the numerator and denominator by the same number.",
      "options": [
        {
          "id": "A",
          "text": "2/3",
          "feedback": "2/3 is greater than 1/2."
        },
        {
          "id": "B",
          "text": "2/4",
          "feedback": "Correct. 1×2 / 2×2 = 2/4."
        },
        {
          "id": "C",
          "text": "3/4",
          "feedback": "3/4 is greater than 1/2."
        },
        {
          "id": "D",
          "text": "1/4",
          "feedback": "1/4 is smaller than 1/2."
        }
      ],
      "correctOption": "B",
      "explanation": "2/4 is equivalent to 1/2 because both numerator and denominator were multiplied by 2."
    },
    {
      "id": "q2",
      "type": "single-choice",
      "question": "Which pair is equivalent?",
      "hint": "Use cross multiplication.",
      "options": [
        {
          "id": "A",
          "text": "2/3 and 4/6",
          "feedback": "Correct. 2×6 = 3×4 = 12."
        },
        {
          "id": "B",
          "text": "1/2 and 2/5",
          "feedback": "The cross-products are 5 and 4, so they are not equal."
        },
        {
          "id": "C",
          "text": "3/4 and 6/10",
          "feedback": "The cross-products are 30 and 24."
        },
        {
          "id": "D",
          "text": "1/3 and 3/6",
          "feedback": "1/3 equals 2/6, not 3/6."
        }
      ],
      "correctOption": "A",
      "explanation": "For 2/3 and 4/6, the cross-products are equal: 12 and 12."
    },
    {
      "id": "q3",
      "type": "single-choice",
      "question": "What is an equivalent fraction for 3/5 when both parts are multiplied by 3?",
      "hint": "Compute 3×3 and 5×3.",
      "options": [
        {
          "id": "A",
          "text": "6/10",
          "feedback": "This is equivalent, but it comes from multiplying by 2, not 3."
        },
        {
          "id": "B",
          "text": "9/15",
          "feedback": "Correct. 3×3 = 9 and 5×3 = 15."
        },
        {
          "id": "C",
          "text": "8/15",
          "feedback": "Only the denominator is consistent with ×3."
        },
        {
          "id": "D",
          "text": "9/10",
          "feedback": "The denominator should also be multiplied by 3."
        }
      ],
      "correctOption": "B",
      "explanation": "Multiplying numerator and denominator of 3/5 by 3 gives 9/15."
    }
  ]
