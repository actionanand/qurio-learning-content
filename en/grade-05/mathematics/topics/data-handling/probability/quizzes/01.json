  "questions": [
    {
      "id": "q1",
      "type": "single-choice",
      "question": "A fair coin is tossed once. What is the probability of Head?",
      "hint": "A fair coin has two equally likely outcomes.",
      "options": [
        {
          "id": "A",
          "text": "1/4",
          "feedback": "There are only two equally likely outcomes."
        },
        {
          "id": "B",
          "text": "1/2",
          "feedback": "Correct. One favourable outcome out of two."
        },
        {
          "id": "C",
          "text": "1",
          "feedback": "Head is not certain."
        },
        {
          "id": "D",
          "text": "0",
          "feedback": "Head is possible."
        }
      ],
      "correctOption": "B",
      "explanation": "There is 1 favourable Head outcome out of 2 total outcomes."
    },
    {
      "id": "q2",
      "type": "single-choice",
      "question": "Which value can be a probability?",
      "hint": "Probability is between 0 and 1.",
      "options": [
        {
          "id": "A",
          "text": "-1",
          "feedback": "Probability cannot be negative."
        },
        {
          "id": "B",
          "text": "3/2",
          "feedback": "This is greater than 1."
        },
        {
          "id": "C",
          "text": "3/4",
          "feedback": "Correct. 3/4 lies between 0 and 1."
        },
        {
          "id": "D",
          "text": "2",
          "feedback": "This is greater than 1."
        }
      ],
      "correctOption": "C",
      "explanation": "A probability must lie from 0 to 1 inclusive."
    },
    {
      "id": "q3",
      "type": "single-choice",
      "question": "A bag has 3 red and 1 blue ball. What is the probability of picking the blue ball?",
      "hint": "There are 4 balls in total.",
      "options": [
        {
          "id": "A",
          "text": "1/4",
          "feedback": "Correct. One blue ball out of four."
        },
        {
          "id": "B",
          "text": "1/3",
          "feedback": "The total is 4, not 3."
        },
        {
          "id": "C",
          "text": "3/4",
          "feedback": "That is the probability of red."
        },
        {
          "id": "D",
          "text": "1",
          "feedback": "Blue is not certain."
        }
      ],
      "correctOption": "A",
      "explanation": "There is 1 blue ball among 4 total balls."
    }
  ]
