    {
      "id": "q1",
      "type": "single-choice",
      "question": "1/2 के समतुल्य कौन-सा भिन्न है?",
      "hint": "अंश और हर को एक ही संख्या से गुणा करें.",
      "options": [
        {
          "id": "A",
          "text": "2/3",
          "feedback": "2/3, 1/2 से बड़ा है."
        },
        {
          "id": "B",
          "text": "2/4",
          "feedback": "सही। 1×2 / 2×2 = 2/4."
        },
        {
          "id": "C",
          "text": "3/4",
          "feedback": "3/4, 1/2 से बड़ा है."
        },
        {
          "id": "D",
          "text": "1/4",
          "feedback": "1/4, 1/2 से छोटा है."
        }
      ],
      "correctOption": "B",
      "explanation": "अंश और हर दोनों को 2 से गुणा करने पर 2/4 मिलता है, जो 1/2 के बराबर है."
    },
    {
