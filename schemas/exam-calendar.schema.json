{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Qurio Exam Calendar Month",
  "type": "object",
  "required": [
    "schemaVersion",
    "planId",
    "language",
    "month",
    "days"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "planId": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "phaseId",
          "weekNumber",
          "topics",
          "revision",
          "practiceQuizIds",
          "studyMaterialIds",
          "timetable"
        ]
      }
    }
  }
}
