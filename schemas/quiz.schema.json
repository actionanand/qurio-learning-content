{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Qurio Quiz",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "type",
    "language",
    "grade",
    "subject",
    "chapter",
    "topic",
    "title",
    "timeLimitSeconds",
    "passingPercentage",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "const": "quiz"
    },
    "language": {
      "enum": [
        "en",
        "ta",
        "hi"
      ]
    },
    "curriculum": {
      "type": "string"
    },
    "grade": {
      "type": "integer",
      "minimum": 1
    },
    "subject": {
      "type": "string"
    },
    "chapter": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "timeLimitSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "passingPercentage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "shuffleQuestions": {
      "type": "boolean"
    },
    "shuffleOptions": {
      "type": "boolean"
    },
    "sourceNoteIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "type": "string"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "question",
          "options",
          "correctOption",
          "explanation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "const": "single-choice"
          },
          "question": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "id",
                "text",
                "feedback"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "feedback": {
                  "type": "string"
                }
              }
            }
          },
          "correctOption": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          }
        }
      }
    }
  }
}
