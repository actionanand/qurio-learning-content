<div class="editor-grid">
  <div class="editor-pane">
    <div class="pane-head"><strong>Markdown</strong><span>Supports Mermaid + LaTeX</span></div>
    <textarea class="code-editor" name="body" id="markdownBody" data-markdown-source required><%= value || '' %></textarea>
  </div>
  <div class="editor-pane preview-pane">
    <div class="pane-head"><strong>Preview</strong><button class="btn ghost tiny" type="button" data-preview-button>Refresh preview</button></div>
    <div class="markdown-preview" data-markdown-preview><p class="muted">Preview will appear here.</p></div>
  </div>
</div>
