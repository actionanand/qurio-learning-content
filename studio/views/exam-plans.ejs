<%- include('partials/header', { title: 'Exam Plans', subtitle: 'Edit existing multilingual preparation plans and monthly calendars' }) %>
<div class="hero-panel compact-hero"><div><span class="eyebrow">EXAM PREPARATION</span><h1>Plan content lives beside Qurio learning content.</h1><p>This first Studio version safely edits existing plan JSON, overview, syllabus, strategy and listed monthly calendars. A visual daily-plan builder can be added later.</p></div></div>
<div class="cards-grid"><% plans.forEach(plan => { const label = plan.exam?.label?.en || plan.examId; %><article class="plan-card"><div class="plan-badge"><%= plan.exam?.shortName || plan.examId.toUpperCase() %></div><h2><%= label %></h2><p>Class <%= plan.entryClass %> · <%= plan.examYear %><%= plan.demo ? ' · Demo' : '' %></p><code><%= plan.id %></code><div class="lang-actions"><% plan.languages.forEach(lang => { %><a class="btn secondary small" href="/exam-plans/edit?id=<%= encodeURIComponent(plan.id) %>&lang=<%= lang %>"><%= lang.toUpperCase() %></a><% }) %></div></article><% }) %></div>
<%- include('partials/footer') %>
