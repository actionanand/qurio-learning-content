    {
      "id": "q1",
      "type": "single-choice",
      "question": "1/2-க்கு சமமான பின்னம் எது?",
      "hint": "மேல் மற்றும் கீழ் எண்ணை அதே எண்ணால் பெருக்கிப் பாருங்கள்.",
      "options": [
        {
          "id": "A",
          "text": "2/3",
          "feedback": "2/3 என்பது 1/2-ஐ விட பெரியது."
        },
        {
          "id": "B",
          "text": "2/4",
          "feedback": "சரி. 1×2 / 2×2 = 2/4."
        },
        {
          "id": "C",
          "text": "3/4",
          "feedback": "3/4 என்பது 1/2-ஐ விட பெரியது."
        },
        {
          "id": "D",
          "text": "1/4",
          "feedback": "1/4 என்பது 1/2-ஐ விட சிறியது."
        }
      ],
      "correctOption": "B",
      "explanation": "மேல் மற்றும் கீழ் எண்ணையும் 2-ஆல் பெருக்குவதால் 2/4 என்பது 1/2-க்கு சமம்."
    },
    {
      "id": "q2",
      "type": "single-choice",
      "question": "சமமான பின்னங்கள் உள்ள ஜோடி எது?",
      "hint": "குறுக்கு பெருக்கலைப் பயன்படுத்துங்கள்.",
      "options": [
        {
          "id": "A",
          "text": "2/3 மற்றும் 4/6",
          "feedback": "சரி. 2×6 = 3×4 = 12."
        },
        {
          "id": "B",
          "text": "1/2 மற்றும் 2/5",
          "feedback": "குறுக்கு பெருக்கல்கள் 5 மற்றும் 4; சமமில்லை."
        },
        {
          "id": "C",
          "text": "3/4 மற்றும் 6/10",
          "feedback": "குறுக்கு பெருக்கல்கள் 30 மற்றும் 24."
        },
        {
          "id": "D",
          "text": "1/3 மற்றும் 3/6",
          "feedback": "1/3 = 2/6; 3/6 அல்ல."
        }
      ],
      "correctOption": "A",
      "explanation": "2/3 மற்றும் 4/6 இன் குறுக்கு பெருக்கல்கள் இரண்டும் 12."
    },
    {
      "id": "q3",
      "type": "single-choice",
      "question": "3/5 இன் மேல், கீழ் எண்ணை 3-ஆல் பெருக்கினால் கிடைக்கும் சமமான பின்னம் எது?",
      "hint": "3×3 மற்றும் 5×3-ஐ கணக்கிடுங்கள்.",
      "options": [
        {
