    {
      "id": "q1",
      "type": "single-choice",
      "question": "ஆறு முகங்கள் கொண்ட நியாயமான காயில் 6 வருவதற்கான நிகழ்தகவு என்ன?",
      "hint": "ஆறு சம வாய்ப்புள்ள முகங்கள் உள்ளன.",
      "options": [
        {
          "id": "A",
          "text": "1/6",
          "feedback": "சரி."
        },
        {
          "id": "B",
          "text": "1/3",
          "feedback": "6 உள்ள முகம் ஒன்று மட்டுமே."
        },
        {
          "id": "C",
          "text": "1/2",
          "feedback": "மூன்று சாதகமான முகங்கள் தேவைப்படும்."
        },
        {
          "id": "D",
          "text": "1",
          "feedback": "6 உறுதி அல்ல."
        }
      ],
      "correctOption": "A",
      "explanation": "ஆறு முகங்களில் ஒன்று மட்டும் 6; எனவே 1/6."
    },
