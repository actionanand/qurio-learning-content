          "text": "1",
          "feedback": "போதாது."
        },
        {
          "id": "B",
          "text": "3",
          "feedback": "ரத்து செய்வதை சரிபாருங்கள்."
        },
        {
          "id": "C",
          "text": "4",
          "feedback": "சரி."
        },
        {
          "id": "D",
          "text": "24",
          "feedback": "வகுக்கவில்லை."
