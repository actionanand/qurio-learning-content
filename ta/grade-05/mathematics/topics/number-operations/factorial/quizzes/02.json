      "correctOption": "C",
      "explanation": "5! = 120."
    },
    {
      "id": "q2",
      "type": "single-choice",
      "question": "எது பெரியது?",
      "hint": "இரண்டு மதிப்புகளையும் கணக்கிடுங்கள்.",
      "options": [
        {
          "id": "A",
          "text": "3!",
          "feedback": "3! = 6."
        },
        {
          "id": "B",
          "text": "4!",
          "feedback": "சரி. 4! = 24."
        },
        {
          "id": "C",
          "text": "இரண்டும் சமம்",
          "feedback": "6 மற்றும் 24 சமமல்ல."
        },
        {
          "id": "D",
          "text": "தெரியாது",
          "feedback": "இரண்டையும் கணக்கிடலாம்."
        }
      ],
      "correctOption": "B",
      "explanation": "4! = 24 என்பது 3! = 6-ஐ விட பெரியது."
    },
    {
      "id": "q3",
      "type": "single-choice",
      "question": "4! ÷ 3! என்ன?",
